static void calibrateGravityRef() {
  float sx = 0, sy = 0, sz = 0;
  int n = 0;
  for (int i = 0; i < 100; i++) {
    mpu.update();
    sx += mpu.getAccX(); sy += mpu.getAccY(); sz += mpu.getAccZ();
    n++;
    delay(5);
  }
  float m = sqrtf(sx * sx + sy * sy + sz * sz);
  if (n > 0 && m > 0.2f) { gref[0] = sx / m; gref[1] = sy / m; gref[2] = sz / m; }
  Serial.printf("[MPU] upright reference captured (%.2f %.2f %.2f) - keep the bike upright at power-on\n", gref[0], gref[1], gref[2]);
}

static void crashTick() {
  if (!mpuOk) return;
  uint32_t now = millis();
  if (now - lastMpuMs >= 10) {                         // 100 Hz
    lastMpuMs = now;
    mpu.update();
  } else if (crashState != CR_ALERT) {
    return;
  }

  float ax = mpu.getAccX(), ay = mpu.getAccY(), az = mpu.getAccZ();
  float mag = sqrtf(ax * ax + ay * ay + az * az);
  float tilt = 0;
  if (mag > 0.3f) {
    float dot = (ax * gref[0] + ay * gref[1] + az * gref[2]) / mag;
    if (dot > 1.0f) dot = 1.0f;
    if (dot < -1.0f) dot = -1.0f;
    tilt = acosf(dot) * 57.29578f;
  }

  switch (crashState) {
    case CR_IDLE:
      if (mag > 3.5f) {                                // impact
        crashImpactMs = now;
        tiltStartMs = 0;
        crashState = CR_TILT_WATCH;
        Serial.printf("[CRASH] impact %.1f g - watching tilt\n", mag);
      }
      break;

    case CR_TILT_WATCH:
      if (tilt > 60.0f) {
        if (tiltStartMs == 0) tiltStartMs = now;
        if (now - tiltStartMs >= 10000) {              // tilted > 60 deg for 10 s
          crashState = CR_ALERT;
          alertStartMs = now;
          lastBuzzToggleMs = now;
          buzzOn = true;
          digitalWrite(PIN_BUZZER, HIGH);
          Serial.println("[CRASH] CONFIRMED - 15 s cancel window, press the SOS button to cancel");
        }
      } else {
        tiltStartMs = 0;                               // bike came upright again
      }
      if (now - crashImpactMs > 40000 && crashState == CR_TILT_WATCH) {
        crashState = CR_IDLE;                          // false alarm (pothole etc.)
        Serial.println("[CRASH] no sustained tilt - false alarm cleared");
      }
      break;

    case CR_ALERT:
      if (now - lastBuzzToggleMs >= 200) {
        lastBuzzToggleMs = now;
        buzzOn = !buzzOn;
        digitalWrite(PIN_BUZZER, buzzOn ? HIGH : LOW);
      }
      if (digitalRead(PIN_SOS_BTN) == LOW) {
        delay(30);
        if (digitalRead(PIN_SOS_BTN) == LOW) {
          digitalWrite(PIN_BUZZER, LOW);
          crashState = CR_IDLE;
          Serial.println("[CRASH] SOS cancelled by rider");
          break;
        }
      }
      if (now - alertStartMs >= 15000) {
        digitalWrite(PIN_BUZZER, LOW);
        crashState = CR_IDLE;
        triggerGsmSos();
      }
      break;
  }
}

// =================== NETWORK: publish helpers (core 0) ===================
static bool publishPoint(const char* topic, uint16_t& seq, const TripPoint& pt, bool retained) {
  uint8_t inner[18], nonce[12], frame[SAFAR_FRAME_OVERHEAD + 18];
  putLE16(inner, seq);
  memcpy(inner + 2, &pt, sizeof(TripPoint));
  randomNonce(nonce);
  int n = safar_aead_seal(OP_LIVE, keyBytes, nonce, inner, 18, frame);
  if (n <= 0) return false;
  bool ok = mqtt.publish(topic, frame, (unsigned int)n, retained);
  if (ok) seq++;
  return ok;
}

