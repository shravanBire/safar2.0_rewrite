// =================== SMALL HELPERS ===================
static inline void putLE16(uint8_t* p, uint16_t v) { p[0] = (uint8_t)v; p[1] = (uint8_t)(v >> 8); }
static inline uint16_t getLE16(const uint8_t* p) { return (uint16_t)p[0] | ((uint16_t)p[1] << 8); }
static inline uint32_t getLE32(const uint8_t* p) { return sc_load32le(p); }

static bool hexToBytes32(const char* hex, uint8_t* out) {
  if (strlen(hex) != 64) return false;
  for (int i = 0; i < 32; i++) {
    char b[3] = { hex[2 * i], hex[2 * i + 1], 0 };
    char* end = NULL;
    long v = strtol(b, &end, 16);
    if (end == b || *end != 0) return false;
    out[i] = (uint8_t)v;
  }
  return true;
}

static void randomNonce(uint8_t* nonce) { esp_fill_random(nonce, 12); }   // hardware RNG, never repeats in practice

static bool fsLock(uint32_t ms) { return xSemaphoreTake(fsMutex, pdMS_TO_TICKS(ms)) == pdTRUE; }
static void fsUnlock() { xSemaphoreGive(fsMutex); }

// days since 1970-01-01 for a civil date (no timezone, no mktime)
static int64_t daysFromCivil(int y, unsigned m, unsigned d) {
  y -= (m <= 2);
  const int era = (y >= 0 ? y : y - 399) / 400;
  const unsigned yoe = (unsigned)(y - era * 400);
  const unsigned doy = (153 * (m > 2 ? m - 3 : m + 9) + 2) / 5 + d - 1;
  const unsigned doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
  return (int64_t)era * 146097 + (int64_t)doe - 719468;
}

static uint32_t epochFromGps() {
  if (!gps.date.isValid() || !gps.time.isValid()) return 0;
  if (gps.date.age() > 3000 || gps.time.age() > 3000) return 0;
  int y = gps.date.year();
  if (y < 2024) return 0;
  int64_t days = daysFromCivil(y, gps.date.month(), gps.date.day());
  int64_t sec = days * 86400 + (int64_t)gps.time.hour() * 3600 + gps.time.minute() * 60 + gps.time.second();
  sec += gps.time.age() / 1000;
  return (uint32_t)sec;
}

// real UTC epoch, or 0 when no trustworthy time source exists yet (GPS time -> NTP -> running clock)
static uint32_t currentEpoch() {
  uint32_t g = epochFromGps();
  if (g) { clockBaseEpoch = g; clockBaseMs = millis(); return g; }
  time_t t = time(nullptr);
  if (t > 1700000000) { clockBaseEpoch = (uint32_t)t; clockBaseMs = millis(); return (uint32_t)t; }
  if (clockBaseEpoch) return clockBaseEpoch + (millis() - clockBaseMs) / 1000;
  return 0;
}

// =================== CRYPTO SELF-TEST (runs at every boot) ===================
static bool cryptoSelfTest() {
  static const char* GOLD_KEY = "a1b2c3d4e5f60718293a4b5c6d7e8f90a1b2c3d4e5f60718293a4b5c6d7e8f90";
  static const char* GOLD_FRAME =
    "020102030405060708090a0b0c7f8526de0c01105a20d1482764a3388e4e9b906748c2a4a077c4f1f7425bd5df32a9";
  uint8_t key[32], nonce[12], inner[18], out[47];
  if (!hexToBytes32(GOLD_KEY, key)) return false;
  for (int i = 0; i < 12; i++) nonce[i] = (uint8_t)(i + 1);
  for (int i = 0; i < 18; i++) inner[i] = (uint8_t)((i * 7 + 3) & 0xFF);
  int n = safar_aead_seal(0x02, key, nonce, inner, 18, out);
  if (n != 47) return false;
  char hex[100];
  for (int i = 0; i < n; i++) snprintf(hex + 2 * i, 3, "%02x", out[i]);
  bool sealOk = (strcmp(hex, GOLD_FRAME) == 0);
  uint8_t back[32], op = 0;
  int r = safar_aead_open(out, n, key, back, sizeof(back), &op);
  bool openOk = (r == 18 && memcmp(back, inner, 18) == 0 && op == 0x02);
  out[20] ^= 0x01;
  bool tamperOk = (safar_aead_open(out, n, key, back, sizeof(back), &op) == -1);
  Serial.printf("[CRYPTO] self-test seal=%s open=%s tamper-reject=%s\n",
                sealOk ? "PASS" : "FAIL", openOk ? "PASS" : "FAIL", tamperOk ? "PASS" : "FAIL");
  return sealOk && openOk && tamperOk;
}

// =================== LOGGER (core 1) ===================
static void flushLog() {
  if (logCount == 0) return;
  if (!fsLock(500)) return;                       // keep the RAM buffer, try again later
  size_t freeBytes = LittleFS.totalBytes() - LittleFS.usedBytes();
  size_t need = (size_t)logCount * sizeof(TripPoint);
  if (freeBytes < need + FLASH_MIN_FREE) {
    if (!flashFull) Serial.println("[LOG] Flash almost full - new points are dropped until the app syncs");
    flashFull = true;
    logCount = 0;
    fsUnlock();
    return;
  }
  flashFull = false;
  File f = LittleFS.open(TRIPS_FILE, FILE_APPEND);
  bool ok = false;
  if (f) {
    ok = (f.write((const uint8_t*)logBuf, need) == need);
    f.close();
  }
  fsUnlock();
  if (ok) {
    Serial.printf("[LOG] flushed %u points to flash\n", (unsigned)logCount);
    logCount = 0;
  } else {
    Serial.println("[LOG] flash write failed, will retry");
  }
}

static uint32_t logDropped = 0;

static void logPoint(const TripPoint& p) {
#if !DEMO_FAKE_GPS
  if (clearLogBufRequest) { logCount = 0; clearLogBufRequest = false; }
  if (logCount >= LOG_BUF_POINTS) {                 // buffer still full (flash busy/full): try once, else drop this point
    flushLog();
    if (logCount >= LOG_BUF_POINTS) { logDropped++; return; }
  }
  logBuf[logCount++] = p;
  if (logCount >= LOG_BUF_POINTS) flushLog();
#else
  (void)p;
#endif
}

