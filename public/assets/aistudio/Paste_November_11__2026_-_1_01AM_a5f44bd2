static void sensorTick() {
  uint32_t epoch = currentEpoch();
  bool fixOk = false;
  float kmh = 0;
  int32_t latE7 = 0, lonE7 = 0;
  uint8_t sats = 0;

#if DEMO_FAKE_GPS
  {
    static float ang = 0;
    ang += 0.05f;
    latE7 = (int32_t)((21.1458 + 0.002 * sin(ang)) * 10000000.0);
    lonE7 = (int32_t)((79.0882 + 0.002 * cos(ang)) * 10000000.0);
    kmh = 38.0f + 12.0f * sinf(ang * 2.0f);
    sats = 9;
    lastHeadingDiv2 = (uint8_t)(((int)(fmodf(ang * 57.29578f + 90.0f, 360.0f))) / 2);
    fixOk = (epoch != 0);
  }
#else
  fixOk = gps.location.isValid() && gps.location.age() < 3000 && (epoch != 0);
  if (fixOk) {
    latE7 = (int32_t)llround(gps.location.lat() * 10000000.0);
    lonE7 = (int32_t)llround(gps.location.lng() * 10000000.0);
    kmh = gps.speed.isValid() ? (float)gps.speed.kmph() : 0.0f;
    if (kmh < 1.5f) kmh = 0.0f;                       // GPS jitter at standstill
    if (kmh > 400.0f) kmh = 400.0f;
    if (gps.course.isValid() && kmh > 3.0f) {
      int h = (int)gps.course.deg();
      if (h < 0) h = 0;
      if (h > 359) h = 359;
      lastHeadingDiv2 = (uint8_t)(h / 2);
    }
    sats = gps.satellites.isValid() ? (uint8_t)(gps.satellites.value() & 0x1F) : 0;
  }
#endif

  if (!fixOk) {                                        // never invent data: no fix => no point, no log
    publishSnapshot(snap.pt, false);
    return;
  }

  if (epoch <= lastPointEpoch) epoch = lastPointEpoch + 1;   // strictly increasing timestamps
  lastPointEpoch = epoch;

  TripPoint pt;
  pt.timestamp = epoch;
  pt.latE7 = latE7;
  pt.lonE7 = lonE7;
  pt.speedDeciKmh = (uint16_t)(kmh * 10.0f);
  pt.headingDiv2 = lastHeadingDiv2;

  uint32_t nowMs = millis();
  uint8_t eventFlags = 0;

  if (rideState == PARKED) {
    if (kmh >= RIDE_START_KMH) moveCount++; else moveCount = 0;
    if (moveCount >= 3) {                              // ~3 s of movement => new trip
      rideState = RIDING;
      tripStartMs = nowMs;
      stoppedSinceMs = 0;
      firstPointOfTrip = true;
      moveCount = 0;
      Serial.println("[TRIP] ride started");
    }
  } else {                                             // RIDING
    if (kmh < RIDE_STOP_KMH) {
      if (stoppedSinceMs == 0) stoppedSinceMs = nowMs;
    } else {
      stoppedSinceMs = 0;
    }
  }

  bool endNow = (rideState == RIDING && stoppedSinceMs != 0 && (nowMs - stoppedSinceMs) >= RIDE_END_PARK_MS);

  if (rideState == RIDING) {
    if (firstPointOfTrip) { eventFlags |= FLAG_START; firstPointOfTrip = false; }
    if (endNow) eventFlags |= FLAG_END;
  }

  uint8_t baseFlags = (uint8_t)((sats & 0x1F) << 3) | (rideState == RIDING ? FLAG_RIDING : 0);
  TripPoint logged = pt;
  logged.flags = baseFlags | eventFlags;

  if (rideState == RIDING) logPoint(logged);

  TripPoint live = pt;                                 // live frame also carries START for the first 3 s (UI resets trip stats)
  live.flags = baseFlags | eventFlags;
  if (rideState == RIDING && (nowMs - tripStartMs) < 3000) live.flags |= FLAG_START;

  if (endNow) {
    flushLog();
    rideState = PARKED;
    stoppedSinceMs = 0;
    requestStatusNow = true;
    Serial.println("[TRIP] ride ended, log flushed");
  }

  publishSnapshot(live, true);
}

