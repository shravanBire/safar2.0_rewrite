  out = snap;
  portEXIT_CRITICAL(&snapMux);
  return out.valid;
}

// =================== NETWORK: history sync (core 0) ===================
static void saveSyncedOffset(uint32_t off) {
  syncedOffset = off;
  prefs.putUInt("off", off);
}

// remove trips.bin when everything in it was ACKed
static void cleanupFileIfFullySynced() {
  if (!fsLock(500)) return;
  if (LittleFS.exists(TRIPS_FILE)) {
    File f = LittleFS.open(TRIPS_FILE, FILE_READ);
    size_t sz = f ? f.size() : 0;
    if (f) f.close();
    if (syncedOffset >= sz) {
      LittleFS.remove(TRIPS_FILE);
      saveSyncedOffset(0);
      Serial.println("[SYNC] all data ACKed - trip log erased from tracker");
    }
  } else if (syncedOffset != 0) {
    saveSyncedOffset(0);
  }
  fsUnlock();
}

// a stored record is only valid if its time is a real date (>= Oct 2025); junk/old test data is skipped and later erased
static inline bool isPlausible(const TripPoint& r) { return r.timestamp >= 1760000000UL; }

// count records after `cursor` newer than lastTs; also returns file size
static bool scanFile(uint32_t cursor, uint32_t lastTs, uint32_t& newCount, uint32_t& fileSize) {
  newCount = 0; fileSize = 0;
  if (!fsLock(1000)) return false;
  if (!LittleFS.exists(TRIPS_FILE)) { fsUnlock(); return true; }
  File f = LittleFS.open(TRIPS_FILE, FILE_READ);
  if (!f) { fsUnlock(); return false; }
  fileSize = f.size();
  if (cursor > fileSize) cursor = 0;
  f.seek(cursor);
  TripPoint rec;
  while (f.read((uint8_t*)&rec, sizeof(rec)) == sizeof(rec)) {
    if (isPlausible(rec) && rec.timestamp > lastTs) newCount++;
  }
  f.close();
  fsUnlock();
  return true;
}

static void startSync(uint32_t lastTs) {
  syncSt = {};
  uint32_t newCount = 0, fileSize = 0;
  uint32_t cur = syncedOffset - (syncedOffset % sizeof(TripPoint));
  if (!scanFile(cur, lastTs, newCount, fileSize)) return;
  if (cur > fileSize) { cur = 0; saveSyncedOffset(0); }
  if (newCount == 0) {                                 // app already has everything in the file
    if (fileSize > cur) { saveSyncedOffset(fileSize - (fileSize % sizeof(TripPoint))); }
    cleanupFileIfFullySynced();
    Serial.println("[SYNC] nothing new for the app");
    return;
  }
  syncSt.active = true;
  syncSt.lastTs = lastTs;
  syncSt.cursor = cur;
  syncSt.chunkId = 0;
  syncSt.total = (uint16_t)((newCount + 29) / 30);
  Serial.printf("[SYNC] %u new points, %u chunks\n", (unsigned)newCount, (unsigned)syncSt.total);
}

static bool sendCurrentChunk() {
  uint8_t inner[5 + 480];
  memset(inner, 0, sizeof(inner));
  uint8_t count = 0;
  uint32_t next = syncSt.cursor;
  if (!fsLock(1000)) return false;
  File f = LittleFS.open(TRIPS_FILE, FILE_READ);
  if (!f) { fsUnlock(); return false; }
  f.seek(syncSt.cursor);
  TripPoint rec;
  while (count < 30 && f.read((uint8_t*)&rec, sizeof(rec)) == sizeof(rec)) {
    next += sizeof(rec);
    if (isPlausible(rec) && rec.timestamp > syncSt.lastTs) {
      memcpy(inner + 5 + count * sizeof(TripPoint), &rec, sizeof(rec));
      count++;
    }
  }
  f.close();
  fsUnlock();
  if (count == 0) { syncSt.active = false; return false; }

  putLE16(inner + 0, syncSt.chunkId);
  putLE16(inner + 2, syncSt.total);
  inner[4] = count;

  uint8_t nonce[12], frame[SAFAR_FRAME_OVERHEAD + 485];
  randomNonce(nonce);
  int n = safar_aead_seal(OP_HISTORY_CHUNK, keyBytes, nonce, inner, 485, frame);
  if (n <= 0) return false;
  if (!mqtt.publish(topicHist, frame, (unsigned int)n, false)) return false;
  syncSt.nextCursor = next;
  syncSt.waitingAck = true;
  syncSt.sentMs = millis();
  return true;
}

static void syncTick() {
  if (!syncSt.active || !mqtt.connected()) return;
  if (!syncSt.waitingAck) {
    if (syncSt.chunkId >= syncSt.total) {              // finished
      syncSt.active = false;
      cleanupFileIfFullySynced();
      Serial.println("[SYNC] complete");
      return;
    }
    if (!sendCurrentChunk()) {
      if (++syncSt.retries > 3) { syncSt.active = false; Serial.println("[SYNC] aborted (send failed)"); }
    }
    return;
  }
  if (millis() - syncSt.sentMs > 3000) {               // no ACK: resend (stop-and-wait)
    syncSt.waitingAck = false;
    if (++syncSt.retries > 3) {
      syncSt.active = false;
      Serial.println("[SYNC] aborted (no ACK) - will retry on next app session");
    }
  }
}

// =================== NETWORK: incoming commands (core 0) ===================
static void onMqttMessage(char* topic, byte* payload, unsigned int length) {
  (void)topic;
  uint8_t inner[32], op = 0;
  int n = safar_aead_open((const uint8_t*)payload, length, keyBytes, inner, sizeof(inner), &op);
  if (n < 0) return;                                   // not authentic => ignore silently

  uint32_t epoch = currentEpoch();
  switch (op) {
    case OP_OPEN_SESSION:                              // lastSyncedTs(4) + seq(2)
      if (n != 6) return;
      cmdSeq = getLE16(inner + 4);
      cmdSeqValid = true;
      isAppWatching = true;
      lastHeartbeatMs = millis();
      pendingLastTs = getLE32(inner);
      pendingOpen = true;                              // handled in the net loop (never publish inside the callback)
      Serial.println("[APP] session opened");
      break;

    case OP_HEARTBEAT: {                               // ts(4) + seq(2)
      if (n != 6) return;
      uint32_t ts = getLE32(inner);
      uint16_t seq = getLE16(inner + 4);
      if (epoch != 0) {
        int64_t diff = (int64_t)ts - (int64_t)epoch;
        if (diff > 600 || diff < -600) return;         // stale / replayed heartbeat
      }
      if (cmdSeqValid && (int16_t)(seq - cmdSeq) <= 0) return;
      cmdSeq = seq; cmdSeqValid = true;
      isAppWatching = true;
      lastHeartbeatMs = millis();
      break;
    }

    case OP_HISTORY_ACK: {                             // chunkId(2) + status(1) + reserved(1)
      if (n != 4) return;
      uint16_t id = getLE16(inner);
      uint8_t status = inner[2];
      if (syncSt.active && syncSt.waitingAck && id == syncSt.chunkId) {
        if (status == 0) {
          saveSyncedOffset(syncSt.nextCursor);
          syncSt.cursor = syncSt.nextCursor;
          syncSt.chunkId++;
          syncSt.retries = 0;
          syncSt.waitingAck = false;
        } else {
          syncSt.waitingAck = false;                   // app could not store it: resend
          if (++syncSt.retries > 3) syncSt.active = false;
        }
      }
      break;
    }

    case OP_CLEAR_FLASH: {                             // upToTs(4) + mode(1) + seq(2)   (developer tool)
#if ALLOW_REMOTE_CLEAR
      if (n != 7) return;
      uint32_t ts = getLE32(inner);
      uint16_t seq = getLE16(inner + 5);
      if (epoch == 0) return;
      int64_t diff = (int64_t)ts - (int64_t)epoch;
      if (diff > 120 || diff < -120) return;           // must be a fresh command
      if (cmdSeqValid && (int16_t)(seq - cmdSeq) <= 0) return;
      cmdSeq = seq; cmdSeqValid = true;
      if (fsLock(1000)) {
        LittleFS.remove(TRIPS_FILE);
        saveSyncedOffset(0);
        fsUnlock();
      }
      clearLogBufRequest = true;
      syncSt = {};
      Serial.println("[FLASH] trip log erased by app command");
#endif
      break;
    }
    default: break;
  }
}

// =================== NETWORK: connection management + loop (core 0) ===================
static void ensureWifiAndTime() {
  if (WiFi.status() != WL_CONNECTED) {
    ntpStarted = false;
    if (millis() - lastWifiTryMs > 15000 || lastWifiTryMs == 0) {
      lastWifiTryMs = millis();
      Serial.println("[WIFI] connecting...");
      WiFi.disconnect();
      WiFi.begin(WIFI_SSID, WIFI_PASS);
    }
    return;
  }
  if (!ntpStarted) {
    configTime(0, 0, "pool.ntp.org", "time.google.com");   // UTC epoch; no timezone needed
    ntpStarted = true;
    Serial.println("[WIFI] connected, NTP started");
  }
}

static bool tryMqttConnect() {
#if VERIFY_TLS
  if (time(nullptr) < 1700000000) return false;        // certificate validation needs real time
#endif
  char clientId[32];
  snprintf(clientId, sizeof(clientId), "safar_%08x", (unsigned)esp_random());
  Serial.print("[MQTT] connecting...");
  if (!mqtt.connect(clientId, MQTT_USER, MQTT_PASS, topicPresence, 1, true, "0")) {
    Serial.printf(" failed, state=%d\n", mqtt.state());
    return false;
  }
  Serial.println(" connected");
  mqtt.subscribe(topicCmd, 1);
  mqtt.publish(topicPresence, (const uint8_t*)"1", 1, true);
  cmdSeqValid = false;
  syncSt = {};
  lastLiveMs = 0;
  lastStatusMs = 0;
  lastHeartbeatMs = millis();
  return true;
}

static void netTask(void*) {
  for (;;) {
    ensureWifiAndTime();

    if (WiFi.status() == WL_CONNECTED && cryptoOk) {
      if (!mqtt.connected()) {
        if (millis() - lastMqttTryMs > 5000 || lastMqttTryMs == 0) {
          lastMqttTryMs = millis();
          tryMqttConnect();
        }
      } else {
        mqtt.loop();
        uint32_t now = millis();

        if (pendingOpen) { pendingOpen = false; startSync(pendingLastTs); }

        if (isAppWatching && (now - lastHeartbeatMs > WATCH_TIMEOUT_MS)) {
          isAppWatching = false;
          requestStatusNow = true;
          Serial.println("[APP] heartbeat timeout - live streaming stopped");
        }

        Snapshot s;
        bool have = takeSnapshot(s);

        if (isAppWatching && have && (now - lastLiveMs >= LIVE_PERIOD_MS)) {
          lastLiveMs = now;
          if ((now - s.updatedMs) < 3500 && s.pt.timestamp != lastLiveTs) {
            if (publishPoint(topicLive, seqLive, s.pt, false)) lastLiveTs = s.pt.timestamp;
          }
        }

        if (have && !isAppWatching) {
          uint32_t period = s.riding ? STATUS_RIDING_MS : STATUS_PARKED_MS;
          if (requestStatusNow || lastStatusMs == 0 || (now - lastStatusMs) >= period) {
            requestStatusNow = false;
            lastStatusMs = now;
            publishPoint(topicStatus, seqStatus, s.pt, true);     // retained: instant "last seen" for the app
          }
        } else if (isAppWatching) {
          requestStatusNow = false;
        }

        syncTick();
      }
    }
    vTaskDelay(pdMS_TO_TICKS(5));
  }
}

// =================== SETUP / LOOP ===================
void setup() {
  Serial.begin(115200);
  delay(300);
  Serial.println("\n=== SAFAR 2.0 tracker booting ===");

  pinMode(PIN_BUZZER, OUTPUT);
  digitalWrite(PIN_BUZZER, LOW);
  pinMode(PIN_SOS_BTN, INPUT_PULLUP);

  fsMutex = xSemaphoreCreateMutex();

  snprintf(topicStatus,   sizeof(topicStatus),   "safar/v1/%s/status",   DEV_ID);
  snprintf(topicLive,     sizeof(topicLive),     "safar/v1/%s/live",     DEV_ID);
  snprintf(topicCmd,      sizeof(topicCmd),      "safar/v1/%s/cmd",      DEV_ID);
  snprintf(topicHist,     sizeof(topicHist),     "safar/v1/%s/hist",     DEV_ID);
  snprintf(topicPresence, sizeof(topicPresence), "safar/v1/%s/presence", DEV_ID);

  bool keyOk = hexToBytes32(SHARED_SECRET_HEX, keyBytes);
  if (!keyOk) Serial.println("[CONFIG] SHARED_SECRET_HEX must be exactly 64 hex characters!");
  bool selfOk = cryptoSelfTest();
  cryptoOk = keyOk && selfOk;
  if (!cryptoOk) Serial.println("[CRYPTO] NOT OK - network disabled until fixed");

  if (!LittleFS.begin(true)) Serial.println("[FS] LittleFS mount failed");
  prefs.begin("safar", false);
  syncedOffset = prefs.getUInt("off", 0);
  if (prefs.getUInt("fmt", 0) != 2) {                  // first boot of this firmware: erase the old test log (fake data/timestamps)
    LittleFS.remove(TRIPS_FILE);
    prefs.putUInt("off", 0);
    syncedOffset = 0;
    prefs.putUInt("fmt", 2);
    Serial.println("[FS] old test log erased (one-time migration)");
  }

  Wire.begin();                                        // SDA=21, SCL=22
  byte st = mpu.begin(1, 2);                           // gyro 500 dps, accel +-8 g (needed to see > 3.5 g impacts)
  mpuOk = (st == 0);
  if (mpuOk) calibrateGravityRef(); else Serial.println("[MPU] init failed - crash detection disabled");

  gpsSerial.setRxBufferSize(1024);
  gpsSerial.begin(9600, SERIAL_8N1, GPS_RX_PIN, GPS_TX_PIN);

  WiFi.mode(WIFI_STA);
  WiFi.setAutoReconnect(true);
#if VERIFY_TLS
  if (strstr(EMQX_CA_PEM, "PASTE_YOUR") != NULL) Serial.println("[TLS] ERROR: paste the EMQX CA certificate into secrets.h (or set VERIFY_TLS 0 for a quick test)");
  secureClient.setCACert(EMQX_CA_PEM);
#else
  secureClient.setInsecure();
  Serial.println("[TLS] WARNING: certificate verification is OFF");
#endif
  mqtt.setServer(MQTT_BROKER, MQTT_PORT);
  mqtt.setCallback(onMqttMessage);
  mqtt.setBufferSize(640);
  mqtt.setKeepAlive(30);

  xTaskCreatePinnedToCore(netTask, "net", 16384, NULL, 1, NULL, 0);   // network on core 0; loop() stays on core 1
  Serial.printf("[BOOT] topics: safar/v1/%s/{status,live,hist,cmd,presence}\n", DEV_ID);
}

void loop() {
  while (gpsSerial.available() > 0) gps.encode((char)gpsSerial.read());

  static uint32_t lastTickMs = 0;
  uint32_t now = millis();
  if (now - lastTickMs >= 1000) {
    lastTickMs = now;
    sensorTick();
  }

  crashTick();
  delay(2);
}
